/*
 * lilly keymap — Left-hand-"sole" DE-QWERTZ für Lily58 Pro
 * ─────────────────────────────────────────────────────────
 * Konzept:
 *   • Linke Hand = "sole" (Haupt-Hand): Navigation, Mods, Layer,
 *     Makros → rechte Hand bleibt frei für Maus/Stylus.
 *   • Trotzdem beidhändig ausgelegt für normales Tippen.
 *   • DE-QWERTZ (OS auf Deutsch eingestellt → HID-Keycodes
 *     erzeugen automatisch korrekte DE-Zeichen).
 *   • Gaming-freundlich (WASD, Zahlen, Space links, Shift, Ctrl
 *     an gewohnter Position).
 *   • Makro-Layer für Photoshop/GIMP, Video-Editing, etc.
 *   • Split-Keyboard- & Touch-Typing-Anfänger freundlich
 *     durch logische Layer-Struktur und Kommentare.
 *
 * Layer-Übersicht:
 *   0 – BASE:   DE-QWERTZ tippen
 *   1 – LOWER:  Navigation (Pfeile, Home, End…), F-Tasten,
 *               Mediensteuerung → linker Daumen
 *   2 – RAISE:  Kreativ-Makros + Sonderzeichen → rechter Daumen
 *
 * Makros (definiert in /macros):
 *   UNDO, REDO, COPY, PASTE, CUT, SAVE, SEL_ALL,
 *   NEW_LAYER, DUP_LAYER, FREE_TRANSFORM, MERGE_VISIBLE,
 *   ZOOM_IN, ZOOM_OUT, FIT_SCREEN, ADD_EDIT, RIPPLE_DEL
 *
 * Daumen-Cluster:
 *   Links:  ⌘ | ⌥ | LOWER(🖐) | ␣
 *   Rechts: ↵ | ⌫ | RAISE(🖐) | ⌘
 *   → Space am linken Daumen – optimal zum Spielen
 *     und für Daumen-Anfänger.
 *   → Enter & Backspace am rechten Daumen – logisch für
 *     beidhändiges Tippen.
 *
 * ♥ WICHTIG ♥  Dieses Layout setzt DE-Tastaturlayout im
 *   Betriebssystem voraus!  Die HID-Scancodes werden erst
 *   vom OS in die korrekten deutschen Zeichen übersetzt
 *   (Y→Z, Z→Y, [→Ü, ]→+, ;→Ö, '→Ä, ---→ß, `→^, usw.)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    /*
     * ─── Makro-Definitionen ──────────────────────────────
     * Alle Makros sind als `&your_macro` in den Layern
     * verwendbar.
     */
    macros {

        /* ── Allgemeine Shortcuts ─────────────────────── */
        macro_undo: macro_undo {
            compatible = "zmk,behavior-macro";
            label = "UNDO";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp Z>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_redo: macro_redo {
            compatible = "zmk,behavior-macro";
            label = "REDO";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp Z>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_copy: macro_copy {
            compatible = "zmk,behavior-macro";
            label = "COPY";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp C>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_paste: macro_paste {
            compatible = "zmk,behavior-macro";
            label = "PASTE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp V>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_cut: macro_cut {
            compatible = "zmk,behavior-macro";
            label = "CUT";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp X>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_save: macro_save {
            compatible = "zmk,behavior-macro";
            label = "SAVE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp S>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_sel_all: macro_sel_all {
            compatible = "zmk,behavior-macro";
            label = "SEL_ALL";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* ── Photoshop / GIMP / Grafik ────────────────── */
        macro_new_layer: macro_new_layer {
            compatible = "zmk,behavior-macro";
            label = "NEW_LAYER";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_dup_layer: macro_dup_layer {
            compatible = "zmk,behavior-macro";
            label = "DUP_LAYER";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp J>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_free_transform: macro_free_transform {
            compatible = "zmk,behavior-macro";
            label = "FREE_TRANSFORM";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp T>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_merge_visible: macro_merge_visible {
            compatible = "zmk,behavior-macro";
            label = "MERGE_VISIBLE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp E>
                , <&macro_release &kp LALT>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_zoom_in: macro_zoom_in {
            compatible = "zmk,behavior-macro";
            label = "ZOOM_IN";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp EQUAL>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_zoom_out: macro_zoom_out {
            compatible = "zmk,behavior-macro";
            label = "ZOOM_OUT";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp MINUS>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_fit_screen: macro_fit_screen {
            compatible = "zmk,behavior-macro";
            label = "FIT_SCREEN";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp N0>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* ── Video-Editing (Premiere / DaVinci) ──────── */
        macro_add_edit: macro_add_edit {
            compatible = "zmk,behavior-macro";
            label = "ADD_EDIT";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp K>
                , <&macro_release &kp LCTRL>
                ;
        };

        macro_ripple_del: macro_ripple_del {
            compatible = "zmk,behavior-macro";
            label = "RIPPLE_DEL";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp DEL>
                , <&macro_release &kp LSHFT>
                ;
        };

        /* ── DE-spezifische Sonderzeichen (per Makro) ── */
        macro_de_paragraph: macro_de_paragraph {
            compatible = "zmk,behavior-macro";
            label = "PARAGRAPH";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N3>
                , <&macro_release &kp LSHFT>
                ;
        };

        macro_de_dquote: macro_de_dquote {
            compatible = "zmk,behavior-macro";
            label = "DQUOTE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LSHFT>
                ;
        };

        macro_de_ampersand: macro_de_ampersand {
            compatible = "zmk,behavior-macro";
            label = "AMPERSAND";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N6>
                , <&macro_release &kp LSHFT>
                ;
        };

        macro_de_slash: macro_de_slash {
            compatible = "zmk,behavior-macro";
            label = "SLASH";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N7>
                , <&macro_release &kp LSHFT>
                ;
        };

        macro_de_degree: macro_de_degree {
            compatible = "zmk,behavior-macro";
            label = "DEGREE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp GRAVE>
                , <&macro_release &kp LSHFT>
                ;
        };

        macro_de_equal: macro_de_equal {
            compatible = "zmk,behavior-macro";
            label = "EQUAL_DE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N0>
                , <&macro_release &kp LSHFT>
                ;
        };

        macro_de_question: macro_de_question {
            compatible = "zmk,behavior-macro";
            label = "QUESTION";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp MINUS>
                , <&macro_release &kp LSHFT>
                ;
        };
    };

    /*
     * ─── Keymap ──────────────────────────────────────────
     */
    keymap {
        compatible = "zmk,keymap";

        /* ================================================
         * LAYER 0: BASE – DE-QWERTZ (beidhändig)
         * ================================================
         * OS auf DEUTSCH eingestellt → die HID-Scancodes
         * werden automatisch in deutsche Zeichen übersetzt:
         *
         *   HID Y → Z   HID Z → Y   HID [ → Ü
         *   HID ] → +   HID ; → Ö   HID ' → Ä
         *   HID - → ß   HID ` → ^
         *
         * ┌───┬───┬───┬───┬───┬───┐     ┌───┬───┬───┬───┬───┬───┐
         * │ESC│ 1 │ 2 │ 3 │ 4 │ 5 │     │ 6 │ 7 │ 8 │ 9 │ 0 │ ^ │
         * ├───┼───┼───┼───┼───┼───┤     ├───┼───┼───┼───┼───┼───┤
         * │TAB│ Q │ W │ E │ R │ T │     │ Z │ U │ I │ O │ P │ ß │
         * ├───┼───┼───┼───┼───┼───┤     ├───┼───┼───┼───┼───┼───┤
         * │CTL│ A │ S │ D │ F │ G │     │ H │ J │ K │ L │ Ö │ Ä │
         * ├───┼───┼───┼───┼───┼───┼──┬──┼───┼───┼───┼───┼───┼───┤
         * │SFT│ Y │ X │ C │ V │ B │ Ü│ +│ N │ M │ , │ . │ - │SFT│
         * └───┴───┴───┴───┴───┴───┴──┴──┴───┴───┴───┴───┴───┴───┘
         *          ┌───┬───┬───┬───┐     ┌───┬───┬───┬───┐
         *          │⌘  │⌥  │LWR│␣  │     │↵  │⌫  │RSE│⌘  │
         *          └───┴───┴───┴───┘     └───┴───┴───┴───┘
         *
         *   Y (HID Z)  = deutsch Y (unten links)
         *   Z (HID Y)  = deutsch Z (oben rechts, nach T)
         *   Ü (HID [)  = Ü (neben P)
         *   Ö (HID ;)  = Ö (neben L)
         *   Ä (HID ')  = Ä (neben Ö)
         *   ß (HID -)  = ß (neben 0)
         *   ^ (HID `)  = ^ (neben 0)
         *
         *   WASD: bleibt an Position (W=oben, A=home, S=home, D=home).
         *   Space: linker Daumen → Gaming + Touch-Typing.
         */
        default_layer {
            bindings = <
&kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                      &kp N6   &kp N7    &kp N8    &kp N9    &kp N0    &kp GRAVE
&kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T                       &kp Y    &kp U     &kp I     &kp O     &kp P     &kp MINUS
&kp LCTRL &kp A     &kp S     &kp D     &kp F     &kp G                       &kp H    &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B  &kp LBKT   &kp RBKT &kp N    &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                        &kp LGUI &kp LALT &mo 1    &kp SPACE  &kp RET  &mo 2   &kp BSPC &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ================================================
         * LAYER 1: LOWER – Navigation, F-Tasten, Medien
         * ================================================
         * Linker Daumen hält LOWER → Linke Hand:
         *   • Pfeiltasten + Navi-Block (↑ ↓ ← →, Home, End,
         *     PgUp, PgDn, Pos1, Ende)
         *   • F1–F12 für Spiele/Programme
         *   • Mediensteuerung (Play/Pause, Prev, Next)
         * Rechte Hand bleibt frei für Maus!
         *
         * Gaming: Pfeile + F-Tasten + ESC griffbereit links.
         *
         * ┌───┬───┬───┬───┬───┬───┐     ┌───┬───┬───┬───┬───┬───┐
         * │ F1│ F2│ F3│ F4│ F5│ F6│     │ F7│ F8│ F9│F10│F11│F12│
         * ├───┼───┼───┼───┼───┼───┤     ├───┼───┼───┼───┼───┼───┤
         * │ ^ │POS│ ↑ │END│BILD│TAB│     │TRN│TRN│TRN│TRN│TRN│TRN│
         * ├───┼───┼───┼───┼───┼───┤     ├───┼───┼───┼───┼───┼───┤
         * │CAP│ ← │ ↓ │ → │BILD↓│EINF│     │TRN│ ← │ ↓ │ ↑ │ → │TRN│
         * ├───┼───┼───┼───┼───┼───┼──┬──┼───┼───┼───┼───┼───┼───┤
         * │TRN│TRN│TRN│TRN│TRN│TRN│TRN│TRN│TRN│TRN│⏮ │⏯ │⏭ │TRN│
         * └───┴───┴───┴───┴───┴───┴──┴──┴───┴───┴───┴───┴───┴───┘
         *          ┌───┬───┬───┬───┐     ┌───┬───┬───┬───┐
         *          │TRN│TRN│LWR│TRN│     │TRN│TRN│RSE│TRN│
         *          └───┴───┴───┴───┘     └───┴───┴───┴───┘
         */
        lower_layer {
            bindings = <
&kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                      &kp F7   &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&kp GRAVE &kp HOME  &kp UP    &kp END   &kp PGUP  &kp TAB                     &trans   &trans    &trans    &trans    &trans    &trans
&kp CAPS  &kp LEFT  &kp DOWN  &kp RIGHT &kp PGDN  &kp INS                     &trans   &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans
&trans    &trans    &trans    &trans    &trans    &trans  &trans     &trans   &trans   &trans    &kp C_PREV &kp C_PP &kp C_NEXT &trans
                        &trans    &trans    &mo 1    &trans     &trans  &mo 2   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ================================================
         * LAYER 2: RAISE – Kreativ-Makros + Sonderzeichen
         * ================================================
         * Rechter Daumen hält RAISE → Linke Hand = Makros!
         * Alle Shortcuts für Photoshop, GIMP, Video-Editing
         * sind auf der LINKEN Seite (rechte Hand bedient
         * Maus/Stylus).
         *
         * Linke Seite (Makros):
         *   ↩    ↩    📋   📋   ✂   💾
         *   🔍-  🔍+  📐  📄  ✨  🖨
         *   📑  📋  [  ]  —  —
         *   🎬  🗑  —  —  —  —
         *
         * Rechte Seite (DE-Sonderzeichen per Makro):
         *   ^(°)  (leer) "  §  $  %
         *   &  /  (  )  =  ?
         *   _  -  +  =  {  }
         *   —  —  —  —  \  |
         *
         * Legende:
         *   ↩ = UNDO   ↩ = REDO   📋 = COPY   📋 = PASTE
         *   ✂ = CUT   💾 = SAVE   🔍- = ZOOM-  🔍+ = ZOOM+
         *   📐 = FIT   📄 = DUP   ✨ = FREE-T  🖨 = STAMP
         *   📑 = NEW   [ = BR-    ] = BR+   🎬 = ADD EDIT
         *   🗑 = RIPPLE DEL
         *
         * ┌───┬───┬───┬───┬───┬───┐     ┌───┬───┬───┬───┬───┬───┐
         * │↩  │↩  │📋 │📋 │✂  │💾 │     │ ^ │   │ " │ § │ $ │ % │
         * ├───┼───┼───┼───┼───┼───┤     ├───┼───┼───┼───┼───┼───┤
         * │🔍-│🔍+│📐 │📄 │✨ │🖨 │     │ & │ / │ ( │ ) │ = │ ? │
         * ├───┼───┼───┼───┼───┼───┤     ├───┼───┼───┼───┼───┼───┤
         * │📑 │📋*│ [ │ ] │TRN│TRN│     │ _ │ - │ + │ = │ { │ } │
         * ├───┼───┼───┼───┼───┼───┼──┬──┼───┼───┼───┼───┼───┼───┤
         * │🎬 │🗑 │TRN│TRN│TRN│TRN│TRN│TRN│TRN│TRN│ [ │ ] │ \ │ | │
         * └───┴───┴───┴───┴───┴───┴──┴──┴───┴───┴───┴───┴───┴───┘
         *          ┌───┬───┬───┬───┐     ┌───┬───┬───┬───┐
         *          │TRN│TRN│LWR│TRN│     │TRN│TRN│RSE│TRN│
         *          └───┴───┴───┴───┘     └───┴───┴───┴───┘
         *
         *   * Hinweis: SEL_ALL (Strg+A) ist auch hier,
         *     da es oft vor Copy/Paste benötigt wird.
         */
        raise_layer {
            bindings = <
&macro_undo &macro_redo &macro_copy     &macro_paste    &macro_cut      &macro_save                    &macro_de_degree &trans     &macro_de_dquote &macro_de_paragraph &kp DOLLAR     &kp PRCNT
&macro_zoom_out &macro_zoom_in &macro_fit_screen &macro_dup_layer &macro_free_transform &macro_merge_visible &macro_de_ampersand &macro_de_slash &kp LPAR &kp RPAR &macro_de_equal &macro_de_question
&macro_new_layer &macro_sel_all   &kp LBKT &kp RBKT &trans  &trans                         &kp UNDER &kp MINUS &kp KP_PLUS &kp EQUAL    &kp LBRC     &kp RBRC
&macro_add_edit &macro_ripple_del &trans    &trans    &trans    &trans  &trans   &trans  &trans    &trans     &kp LBKT     &kp RBKT     &kp BSLH     &kp PIPE
                        &trans    &trans    &mo 1    &trans     &trans  &mo 2  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
